# Flexbox Linktree — environment template
#
# Copy this file to .env.local and replace placeholders only there.
# Never commit .env.local, real secrets, tokens, or production credentials.
#
#   Copy-Item .env.example .env.local
#
# Prisma CLI reads .env.local through prisma7.config.ts.
# Docker Compose does NOT read .env.local; the committed compose file uses
# explicit development-only values.

# PostgreSQL connection string for local development.
# Matches docker-compose.yml: user `flexbox`, host port 5433, database flexbox_linktree_dev.
DATABASE_URL="postgresql://flexbox:dev-only-password@localhost:5433/flexbox_linktree_dev?schema=public"

# Canonical application URL. Auth.js v4 uses NEXTAUTH_URL for callback handling;
# secure cookies get their __Secure-/__Host- prefixes when this starts with https://.
NEXTAUTH_URL="http://localhost:3000"

# JWT/session-signing secret for Auth.js. Generate a different unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# NEXTAUTH_SECRET is the primary Phase 4 name. AUTH_SECRET remains an accepted compatibility alias;
# set one, not both, outside a controlled secret rotation.
NEXTAUTH_SECRET="replace-with-a-unique-locally-generated-session-secret"

# Dedicated HMAC key for source-based rate-limit buckets. It MUST differ from NEXTAUTH_SECRET.
RATE_LIMIT_SECRET="replace-with-a-different-unique-locally-generated-rate-limit-secret"

# Set true only behind a trusted reverse proxy that overwrites x-forwarded-for and x-real-ip.
# Local development must keep this false.
TRUST_PROXY_HEADERS="false"

# Development-only mail transport for password recovery. It writes messages under
# .local-storage/mail/ (git-ignored) and must not be used in production.
ADMIN_MAIL_TRANSPORT="file"

# One-time first administrator bootstrap. Leave false in normal development and always in
# production after bootstrap. The CLI also refuses if any admin account already exists.
ADMIN_BOOTSTRAP_ENABLED="false"
ADMIN_BOOTSTRAP_EMAIL=""
ADMIN_BOOTSTRAP_NAME=""

# Media storage driver for the CMS media library. `local` writes under
# `.local-storage/uploads/` (git-ignored, development only); `s3` selects the
# S3-compatible adapter and is required in production. When unset, the default is
# `local` outside production and `s3` in production.
MEDIA_STORAGE_DRIVER="local"

# Optional local-storage overrides. Leave both empty to use the defaults:
#   MEDIA_LOCAL_ROOT       absolute or relative directory for uploaded files
#   MEDIA_LOCAL_PUBLIC_URL base URL when a CDN or reverse proxy serves the files
MEDIA_LOCAL_ROOT=""
MEDIA_LOCAL_PUBLIC_URL=""

# Escape hatch for non-production environments that run with NODE_ENV=production
# but still use the local driver. Always leave false in real production.
MEDIA_ALLOW_LOCAL_IN_PRODUCTION="false"

# S3-compatible storage credentials. Required when MEDIA_STORAGE_DRIVER="s3".
# Works with AWS S3, Cloudflare R2, MinIO, and other compatible providers.
S3_BUCKET=""
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional: custom endpoint for R2/MinIO and a public read base URL (CDN).
S3_ENDPOINT=""
S3_PUBLIC_URL=""
