# Flexbox Linktree — environment template
#
# Copy this file to .env.local and replace the placeholders with local values.
# Never commit .env.local, real secrets, or production credentials.
#
#   Copy-Item .env.example .env.local
#
# Prisma CLI reads .env.local through prisma7.config.ts.
# Docker Compose does NOT read .env.local; the committed compose file uses
# explicit development-only values.

# PostgreSQL connection string for local development.
# Matches docker-compose.yml: user `flexbox`, host port 5433, database flexbox_linktree_dev.
DATABASE_URL="postgresql://flexbox:dev-only-password@localhost:5433/flexbox_linktree_dev?schema=public"

# Session-signing secret for Auth.js. Generate a unique value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Required from the authentication phase onward. Never reuse across environments.
AUTH_SECRET="replace-with-a-unique-locally-generated-secret"
