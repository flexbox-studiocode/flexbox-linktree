{
  "name": "flexbox-linktree",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "qa:visual": "node scripts/visual-qa.mjs",
    "qa:a11y": "node scripts/a11y-audit.mjs && node scripts/a11y-interaction.mjs",
    "qa:e2e": "node scripts/e2e-release.mjs",
    "perf:smoke": "node scripts/perf-smoke.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:check": "tsx prisma/check.ts",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore:verify": "node scripts/db-restore-verify.mjs",
    "admin:bootstrap": "tsx --env-file=.env.local src/features/auth/cli/run.ts bootstrap.ts",
    "admin:invite": "tsx --env-file=.env.local src/features/auth/cli/run.ts invite.ts",
    "admin:accept-invite": "tsx --env-file=.env.local src/features/auth/cli/run.ts accept-invitation.ts",
    "admin:set-status": "tsx --env-file=.env.local src/features/auth/cli/run.ts set-status.ts",
    "admin:cleanup": "tsx --env-file=.env.local src/features/auth/cli/run.ts cleanup.ts",
    "analytics:cleanup": "tsx --env-file=.env.local src/features/analytics/cli/run.ts cleanup.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.6",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.5",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.18.0"
  },
  "packageManager": "pnpm@12.18.0"
}
